{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent Store Operations Normalized Static Facts",
  "type": "object",
  "required": ["source_url"],
  "properties": {
    "source_url": {"type": "string"},
    "page_title": {"type": ["string", "null"]},
    "canonical_url": {"type": ["string", "null"]},
    "noindex": {"type": "boolean"},
    "visible_price": {"type": ["number", "null"]},
    "visible_currency": {"type": ["string", "null"]},
    "structured_price": {"type": ["number", "null"]},
    "structured_currency": {"type": ["string", "null"]},
    "structured_availability": {"type": ["string", "null"]},
    "has_product_schema": {"type": "boolean"},
    "direct_purchase_signal": {"type": "boolean"},
    "quote_based_signal": {"type": "boolean"},
    "out_of_stock_signal": {"type": "boolean"},
    "return_links": {"type": "array", "items": {"type": "string"}},
    "shipping_links": {"type": "array", "items": {"type": "string"}},
    "contact_links": {"type": "array", "items": {"type": "string"}},
    "subscription_signal": {"type": "boolean"},
    "intro_price": {"type": ["number", "null"]},
    "standard_price": {"type": ["number", "null"]},
    "cadence": {"type": ["string", "null"]},
    "auto_renew_signal": {"type": "boolean"},
    "trial_length_days": {"type": ["integer", "null"]},
    "cancel_signal": {"type": "boolean"},
    "internal_links": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
