{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent Store Operations Normalized Transaction Offers",
  "type": "object",
  "required": ["source_url", "offers"],
  "properties": {
    "source_url": {"type": "string"},
    "region": {"type": ["string", "null"]},
    "currency_context": {"type": ["string", "null"]},
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["offer_type"],
        "properties": {
          "offer_type": {
            "enum": ["ONE_TIME", "RECURRING", "TRIAL_TO_PAID", "PROMO_TO_STANDARD", "UNKNOWN"]
          },
          "label": {"type": ["string", "null"]},
          "currency": {"type": ["string", "null"]},
          "initial_price": {"type": ["number", "null"]},
          "recurring_price": {"type": ["number", "null"]},
          "cadence": {"type": ["string", "null"]},
          "auto_renew": {"type": ["boolean", "null"]},
          "trial_days": {"type": ["integer", "null"]},
          "cancel_signal": {"type": ["boolean", "null"]},
          "provider_of_record": {"type": ["string", "null"]},
          "region": {"type": ["string", "null"]},
          "evidence_text": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
