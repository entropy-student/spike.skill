{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comic Narrative Topic Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "entry_mode",
    "x_domain",
    "human_process",
    "paradox",
    "why_question",
    "human_tension",
    "ai_changed_process",
    "main_mechanism",
    "human_stakes",
    "audience_payoff",
    "meaning_fingerprint",
    "content_job",
    "selection_status",
    "duplicate_reason",
    "evidence_or_uncertainty"
  ],
  "properties": {
    "topic": {"type": "string"},
    "entry_mode": {"enum": ["HUMAN_WORLD_FIRST", "AI_SIGNAL_TRANSLATED", "EXPLICIT_OWNER_TOPIC"]},
    "x_domain": {"type": "string"},
    "human_process": {"type": "string"},
    "paradox": {"type": "string"},
    "why_question": {"type": "string"},
    "human_tension": {"type": "string"},
    "ai_changed_process": {"type": "string"},
    "main_mechanism": {"type": "string"},
    "human_stakes": {"type": "string"},
    "audience_payoff": {"type": "string"},
    "meaning_fingerprint": {"type": "string"},
    "content_job": {"enum": ["DISCOVERY", "TRUST", "SOLUTION"]},
    "selection_status": {"enum": ["PASS", "HOLD_DUPLICATE", "RETURN"]},
    "duplicate_reason": {"type": ["string", "null"]},
    "evidence_or_uncertainty": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
